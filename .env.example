# gres configuration.
#
# Every value here is OPTIONAL — gres runs with sensible defaults and no
# .env file at all. Copy this to `.env` only if you want to change one:
#
#   cp .env.example .env
#
# Integration credentials (Home Assistant, Jellyfin, Proxmox) do NOT go
# here. You enter those in the Settings tab once the app is running, and
# they are stored in the data volume.

# Port gres listens on. With Docker this changes the published host port.
PORT=3000

# error | warn | info | debug
LOG_LEVEL=warn

# How often the Smart Home tab polls Home Assistant, in seconds.
# Set to 0 to disable polling.
HA_REFRESH_INTERVAL_SEC=15

# Optional numeric PIN gates, off unless you set them.
#   SETTINGS_PIN  guards the Settings tab, your stored credentials, and
#                 every change to settings.
#   DEVICES_PIN   guards individual devices you flag as protected in
#                 Settings -> Smart device protection.
#   SERVER_PIN    guards Proxmox power actions: node shutdown/reboot and
#                 starting or stopping a VM. Reading stays open, so the
#                 Server tab still renders without it.
# They are independent, so they can share a code or differ. The PIN is
# never sent to the browser — gres only answers whether a guess matched,
# and a match is remembered in a signed HttpOnly cookie.
#
# A scope with no PIN set is not protected. If gres is reachable by anyone
# you would not hand the remote to, set at least SETTINGS_PIN.
# Uncomment and choose your own before enabling.
#SETTINGS_PIN=
#DEVICES_PIN=
#SERVER_PIN=

# Signing key for those session cookies. Leave unset and gres generates one
# on first boot and keeps it in the data volume, which is what you want —
# set it only if you want sessions to survive the volume being recreated.
#SESSION_SECRET=

# Only if gres sits behind a reverse proxy. Rate limiting and the PIN
# lockout key on the client IP, which is the proxy's address unless gres is
# told how many hops to look back. Set to 1 for a single proxy.
# Leave unset otherwise — trusting the header with no proxy in front lets
# anyone fake their IP and walk past both protections.
#TRUST_PROXY=1
