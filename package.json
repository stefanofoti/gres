    "pino-http": "^11.0.0",
    "yahoo-finance2": "^3.15.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supertest": "^6.3.4"
  }
}
