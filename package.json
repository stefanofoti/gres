  "description": "Gres - Lightweight integrated control pane for smart homes",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest",
    "test:backend": "jest --selectProjects backend",
